{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kafka2306.github.io/cedar-pollen-bi/schemas/cedar-pollen-record.schema.json",
  "title": "Cedar pollen male-flower-bud observation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "prefecture_code",
    "prefecture_name_ja",
    "survey_year",
    "metric_type",
    "value",
    "unit",
    "comparison_status",
    "source"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{5,127}$"},
    "prefecture_code": {"type": "string", "pattern": "^(0[1-9]|[1-3][0-9]|4[0-7])$"},
    "prefecture_name_ja": {"type": "string", "minLength": 2},
    "survey_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
    "metric_type": {
      "type": "string",
      "enum": ["official_flower_bud_observation", "calculated_baseline_ratio"]
    },
    "value": {"type": ["number", "null"], "minimum": 0},
    "unit": {"type": "string", "minLength": 1},
    "baseline": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["start_year", "end_year", "value", "unit"],
      "properties": {
        "start_year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "end_year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "value": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "comparison_status": {
      "type": "string",
      "enum": ["comparable", "not_comparable", "unknown"]
    },
    "not_comparable_reason": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "document_url", "published_date", "retrieved_at", "locator"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "document_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "published_date": {"type": "string", "format": "date"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "transformation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["formula", "input_record_ids"],
      "properties": {
        "formula": {"type": "string", "minLength": 1},
        "input_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    }
  }
}
